#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var logger = require('../lib/logger');
var requestLogger = require('../lib/request-logger');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.on('error', onError);
server.on('listening', onListening);

process.on('SIGINT', shutdown);
process.on('SIGTERM', shutdown);
var shuttingDown = false;

try {
  server.listen(port);
} catch (error) {
  onError(error);
}

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  // Do not emit raw errors: messages may contain paths or credentials.
  var code = ['EACCES', 'EADDRINUSE'].indexOf(error.code) !== -1
    ? error.code
    : 'UNKNOWN';
  logger.error('server_error', { code: code });
  process.exit(1);
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  logger.info('server_listening', typeof addr === 'string'
    ? { transport: 'pipe' }
    : { transport: 'tcp', port: addr.port });
}

/**
 * Drain active requests on shutdown, with a bounded wait for keep-alive clients.
 */

function shutdown(signal) {
  if (shuttingDown) {
    return;
  }
  shuttingDown = true;
  logger.info('server_stopping', { signal: signal });

  var terminated = false;
  var timeout = null;
  const terminate = () => {
    if (terminated) {
      return;
    }
    terminated = true;
    clearTimeout(timeout);
    // Restore Node's default signal termination on every shutdown path.
    process.removeListener(signal, shutdown);
    process.kill(process.pid, signal);
  };

  timeout = setTimeout(function() {
    logger.error('server_shutdown_timeout');
    requestLogger.finalizeOutstanding();
    // Flush the final records if the collector is writable, but never wait
    // beyond the deadline for a blocked collector.
    logger.flush(terminate);
    setImmediate(terminate);
  }, 10000);
  timeout.unref();

  server.close(function(error) {
    if (error) {
      logger.error('server_shutdown_error');
    } else {
      logger.info('server_stopped');
    }
    // Keep the shutdown deadline active while a slow collector drains output.
    logger.flush(terminate);
  });

  // Available on newer Node releases; retain compatibility with Node 14.
  if (typeof server.closeIdleConnections === 'function') {
    server.closeIdleConnections();
  }
}
